rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Menu photos: public read, staff upload via the menu editor.
    function isManager() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager'];
    }
    // Blog images: public read, managers upload from the blog editor.
    match /blog/{file} {
      allow read: if true;
      allow write: if isManager()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /menu/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
