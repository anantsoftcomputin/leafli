# ─────────────────────────────────────────────────────────────
# Leafli Kitchen — files that must never reach GitHub
# ─────────────────────────────────────────────────────────────

# ── Secrets & credentials ────────────────────────────────────
# .env holds the Firebase service-account key, Razorpay, Porter
# and Zomato secrets. Only the blank template is committed.
.env
.env.*
!.env.example

# Stray credential files (service-account JSON, keys, certs)
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
*credentials*.json
*.pem
*.p12
*.key
*.crt
.runtimeconfig.json

# ── Dependencies ─────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js / build output ───────────────────────────────────
/.next/
/.next-verify/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# ── Firebase CLI, emulators & App Hosting ────────────────────
.firebase/
*-debug.log
firebase-export-*/
emulator-data/
.apphosting/

# ── Testing ──────────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Hosting providers ────────────────────────────────────────
.vercel
.netlify

# ── Editors & OS ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Local AI-assistant settings (per machine) ────────────────
.claude/settings.local.json
