# --- Firebase web app (Project settings → Your apps → Web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (local dev only; App Hosting uses its own service account)
# Paste the service-account JSON on ONE line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Who becomes admin on first sign-in (comma separated)
ADMIN_EMAILS=jigarredesai@gmail.com
ADMIN_PHONES=

# --- Browser origins allowed to call /api/public/* and /api/orders
CORS_ALLOWED_ORIGINS=https://leafli.in,https://www.leafli.in,http://localhost:3000

# --- Porter (UAT: https://pfe-apigw-uat.porter.in, prod: https://pfe-apigw.porter.in)
PORTER_BASE_URL=https://pfe-apigw-uat.porter.in
PORTER_API_KEY=
PORTER_WEBHOOK_SECRET=

# --- Zomato (via POS-partner integration or relay middleware)
ZOMATO_WEBHOOK_SECRET=
ZOMATO_AUTO_ACCEPT=false
ZOMATO_STATUS_CALLBACK_URL=
ZOMATO_ITEM_STOCK_URL=
ZOMATO_API_KEY=

# --- Razorpay (Dashboard → Account & Settings → API keys; use rzp_test_ keys until go-live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://<domain>/api/payments/razorpay/webhook, active events:
# payment.authorized, payment.captured, payment.failed, order.paid, refund.processed, refund.failed, payment_link.paid
RAZORPAY_WEBHOOK_SECRET=

# --- Public site
NEXT_PUBLIC_SITE_URL=https://leafli.in
# Google Search Console → Settings → Ownership verification → HTML tag content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email (GoDaddy Workspace / Professional Email SMTP: smtpout.secureserver.net, 465 SSL)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=support@leafli.in
SMTP_PASS=
EMAIL_FROM="Leafli <support@leafli.in>"
# Where new-order / refund-problem alerts for the team go (comma separated)
STAFF_ALERT_EMAILS=support@leafli.in

# --- WhatsApp Cloud API (Meta). developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Business settings → System users → Generate token (whatsapp_business_messaging + whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=
# App settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
# Any random string; paste the same value in the app's WhatsApp → Configuration → Webhook "Verify token"
WHATSAPP_VERIFY_TOKEN=
# Team members who get new-order / problem alerts on WhatsApp (comma separated, with country code)
STAFF_WHATSAPP_NUMBERS=
# Optional: WHATSAPP_API_VERSION=v23.0, WHATSAPP_TEMPLATE_LANG=en
